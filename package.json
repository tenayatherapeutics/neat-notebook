{
  "name": "neat-notebook",
  "version": "0.1.4",
  "description": "A lightweight active-cell inspector for Jupyter Notebook 7 and JupyterLab 4.",
  "license": "BSD-3-Clause",
  "author": {
    "name": "Farshad Farshidfar",
    "email": "farshidfar@gmail.com",
    "url": "https://github.com/farshadf"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tenayatherapeutics/neat-notebook.git"
  },
  "homepage": "https://github.com/tenayatherapeutics/neat-notebook#readme",
  "bugs": {
    "url": "https://github.com/tenayatherapeutics/neat-notebook/issues"
  },
  "keywords": [
    "jupyter",
    "jupyterlab-extension",
    "notebook",
    "cells"
  ],
  "packageManager": "yarn@3.5.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "styleModule": "style/index.js",
  "sideEffects": [
    "style/*.css",
    "style/index.js"
  ],
  "files": [
    "lib",
    "src",
    "style",
    "schema",
    "neat_notebook/tenaya-icon.png",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "jlpm build:lib && jupyter-builder build --development True .",
    "build:lib": "tsc -b",
    "build:prod": "jlpm build:lib && jupyter-builder build .",
    "lint:check": "eslint . --max-warnings=0 && prettier --check . && python -m ruff check . && python -m ruff format --check .",
    "format": "prettier --write . && python -m ruff format .",
    "test:ui": "playwright test",
    "test:types": "tsc -p ui-tests/tsconfig.json"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.5.7 || ~4.7.0-alpha.2",
    "@jupyterlab/cells": "^4.5.7 || ~4.7.0-alpha.2",
    "@jupyterlab/notebook": "^4.5.7 || ~4.7.0-alpha.2",
    "@jupyterlab/settingregistry": "^4.5.7 || ~4.7.0-alpha.2",
    "@jupyterlab/translation": "^4.5.7 || ~4.7.0-alpha.2",
    "@lumino/widgets": "^2.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@jupyter/builder": "^1.2.4",
    "@jupyter/eslint-plugin": "^1.4.0",
    "@playwright/test": "1.63.0",
    "@types/json-schema": "^7.0.11",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^2.8.8",
    "react": "^18.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "resolutions": {
    "@jupyterlab/application": "4.6.4",
    "@jupyterlab/cells": "4.6.4",
    "@jupyterlab/notebook": "4.6.4",
    "@jupyterlab/settingregistry": "4.6.4",
    "@jupyterlab/translation": "4.6.4"
  },
  "jupyterlab": {
    "extension": true,
    "schemaDir": "schema",
    "outputDir": "neat_notebook/labextension",
    "disabledExtensions": [
      "@jupyter-notebook/notebook-extension:cell-inspector"
    ],
    "sharedPackages": {
      "@jupyterlab/application": {
        "singleton": true,
        "bundled": false
      },
      "@jupyterlab/cells": {
        "singleton": true,
        "bundled": false
      },
      "@jupyterlab/notebook": {
        "singleton": true,
        "bundled": false
      },
      "@jupyterlab/settingregistry": {
        "singleton": true,
        "bundled": false
      },
      "@jupyterlab/translation": {
        "singleton": true,
        "bundled": false
      },
      "@lumino/widgets": {
        "singleton": true,
        "bundled": false
      }
    }
  }
}
